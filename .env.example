# Cegnal backend — environment variables
# Copy this file to .env and fill in your values. Never commit the real .env.

# MongoDB Atlas connection string.
# Atlas > Cluster > Connect > Drivers > copy the SRV string, then:
#  - replace <password> with your database user's password
#  - add /cegnal? before the ?  (this names the database "cegnal")
# Example:
# DATABASE_URL="mongodb+srv://cegnal_user:MyPassword123@cluster0.abcde.mongodb.net/cegnal?retryWrites=true&w=majority&appName=Cluster0"
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/cegnal?retryWrites=true&w=majority"

# Secret used to sign JWTs (auth tokens). Use a long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the Express server listens on
PORT=4000

# SMTP — used to send OTP verification emails
# For Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com

# Paystack — real payment processing for plans and zone subscriptions.
# Get both keys from https://dashboard.paystack.com/#/settings/developers
# Use the test (pk_test_/sk_test_) keys while developing.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
